{
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "oauth:allow-start",
    "oauth:allow-cancel",
    "shell:allow-open",
    "deep-link:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "schemes": [
            "https",
            "http"
          ]
        }
      ]
    }
  ]
}