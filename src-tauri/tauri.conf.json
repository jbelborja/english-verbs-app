{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EnglishVerbs",
  "version": "0.1.0",
  "identifier": "com.jbelborja.englishverbsapp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "English Verbs",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "deep-link": {
      "mobile": [
        {
          "schemes": [
            "com.jbelborja.englishverbsapp"
          ]
        }
      ],
      "desktop": {
        "schemes": [
          "com.jbelborja.englishverbsapp"
        ]
      }
    }
  }
}